### input X_user, X_ant: shape (B, 4*K, N)
### ouptut y_h_next, y_w_next: shape (B, 2K, token_dim) and (B, 2N, token_dim)
class TransformerBlock(nn.Module):
    def __init__(self, token_dim, seq_len, n_head, resid_pdrop, embed_dim, config):
        super(TransformerBlock, self).__init__()
        d_model = config.d_model
        n_head = config.n_head
        assert d_model % n_head == 0, "d_model must be divisible by n_head"     
        # Set dimensions
        self.K = config.num_users   # Number of users
        self.N = config.num_tx      # Number of transmit antennas
        self.num_tokens_h = 2 * self.K  # number of tokens in the H-stream (here 2*K)
        self.num_tokens_w = 2 * self.N  # number of tokens in the W-stream (here 2*N)

        # single-layer at first
        self.self_attn_user = MultiHeadAttention(
            token_dim=token_dim, seq_len=seq_len, d_model=d_model, num_heads=n_head, embed_dim=embed_dim, dropout=resid_pdrop
        )

        self.self_attn_ant = MultiHeadAttention(
            token_dim=token_dim, seq_len=seq_len, d_model=d_model, num_heads=n_head, embed_dim=embed_dim, dropout=resid_pdrop
        )

        #### layernorm before MLP and FC layers
        # self.y_h_ln = nn.LayerNorm(token_dim)  # LayerNorm for H-stream output
        # self.y_w_ln = nn.LayerNorm(token_dim)  # LayerNorm for W-stream output
        # self.y_p_ln = nn.LayerNorm(token_dim)  # LayerNorm for P-stream output
        self.context_ln = nn.LayerNorm(token_dim)  # LayerNorm for context features

        self.mlp_h = nn.Sequential(
            nn.Linear(token_dim, 4 * token_dim),
            nn.LayerNorm(4 * token_dim), # TBD
            nn.GELU(),
            nn.Dropout(resid_pdrop),
            nn.Linear(4 * token_dim, 4 * token_dim),  # additional layer
            nn.LayerNorm(4 * token_dim), # TBD
            nn.GELU(),
            nn.Dropout(resid_pdrop),
            nn.Linear(4 * token_dim, token_dim),
            nn.Dropout(resid_pdrop),
        )

        self.mlp_w = nn.Sequential(
            nn.Linear(token_dim, 4 * token_dim),
            nn.LayerNorm(4 * token_dim), # TBD
            nn.GELU(),
            nn.Dropout(resid_pdrop),
            nn.Linear(4 * token_dim, 4 * token_dim),  # additional layer
            nn.LayerNorm(4 * token_dim), # TBD
            nn.GELU(),
            nn.Dropout(resid_pdrop),
            nn.Linear(4 * token_dim, token_dim),
            nn.Dropout(resid_pdrop),
        )

        self.mlp_p = nn.Sequential(
            nn.Linear(token_dim, 4 * token_dim),
            nn.LayerNorm(4 * token_dim), # TBD
            nn.GELU(),
            nn.Dropout(resid_pdrop),
            nn.Linear(4 * token_dim, 4 * token_dim),  # additional layer
            nn.LayerNorm(4 * token_dim), # TBD
            nn.GELU(),
            nn.Dropout(resid_pdrop),
            nn.Linear(4 * token_dim, token_dim),
            nn.Dropout(resid_pdrop),
        )

        self.fc_w = nn.Linear(token_dim, token_dim)  # FC for W-stream output

    def forward(self, X_user, X_ant):
        """
        Args:
          X_user: concatenated [H;W] tokens, shape (B, 6*K, N), 6*K = 3*num_tokens_h
          X_ant: concatenated [H^T;W^T] tokens, shape (B, 6*N, K), 6*N = 3*num_tokens_w
        Returns:
          y_h_next: output features for H-stream, shape (B, 2K, token_dim)
          y_w_next: output features for W-stream, shape (B, 2N, token_dim)
        """
        # 1) Self‐attention + residual + norm
        # y_h_mlp_user, y_w_mlp_user, y_p_mlp_user = self.self_attn_user(X_user)  # (B, 2K, token_dim)
        # y_h_mlp_ant, y_w_mlp_ant, y_p_mlp_ant = self.self_attn_ant(X_ant) # (B, 2N, token_dim)

        # y_h_mlp = y_h_mlp_user + y_h_mlp_ant  # (B, 2K, token_dim)
        # y_w_mlp = y_w_mlp_user + y_w_mlp_ant      # (B, 2N, token_dim)
        # y_p_mlp = y_p_mlp_user + y_p_mlp_ant  # (B, 2N, token_dim) 

        context_user = self.self_attn_user(X_user)  # (B, 2K, token_dim)
        context_ant = self.self_attn_ant(X_ant)  # (B, 2N, token_dim)
        context_mlp = context_user + context_ant  # (B, 2K, token_dim)

        context_mlp_ln = self.context_ln(context_mlp)  # LayerNorm for context features

        y_h_mlp_out = self.mlp_h(context_mlp_ln)  # MLP for H-stream output, size (B, 2K+2N, token_dim)
        y_h_next = context_mlp + y_h_mlp_out # (B, 2K, token_dim)  # residual connection

        y_p_mlp_out = self.mlp_p(context_mlp_ln)  # MLP for P-stream output, size (B, 2N, token_dim)
        y_p_next = context_mlp + y_p_mlp_out  # residual connection

        y_w_mlp_out = self.mlp_w(context_mlp_ln)  # MLP for W-stream output, size (B, 2N, token_dim)
        y_w_out = context_mlp + y_w_mlp_out  # residual connection

        y_w_flat = y_w_out.reshape(y_w_out.shape[0], -1)  # flatten W-stream output to (B, beam_dim)
        norm = th.norm(y_w_flat, dim=1, keepdim=True)  # normalize W-stream output
        y_w_flat = y_w_flat / norm #( B, beam_dim)
        y_w_next = y_w_flat.reshape(y_w_out.shape[0], self.num_tokens_w, -1)  # reshape to (B, 2N, token_dim)

        return y_h_next, y_w_next, y_p_next  # return the output features for H-stream, W-stream, and P-stream


