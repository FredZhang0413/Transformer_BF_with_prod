class MultiHeadAttention(nn.Module): ### self-attention version
    def __init__(self, token_dim, seq_len, d_model, num_heads, embed_dim, dropout):
        """
        d_model: dimension of each token (D)
        num_heads: number of attention heads (h)
        dropout:   dropout on attention weights and output
        """
        super().__init__()
        assert d_model % num_heads == 0, "d_model must be divisible by num_heads"
        self.token_dim = token_dim # N / K (user_level / antenna_level)
        self.seq_len = seq_len # 4K / 4N (user_level / antenna_level)
        self.num_tokens_h = seq_len // 3  # number of tokens in the H-stream (here 2*K or 2*N)
        self.d_model = d_model # token dimension when using the multi-head attention
        self.num_heads = num_heads # number of attention heads
        self.head_dim = d_model // num_heads # dimension of each head (d)

        self.x_embedding = nn.Linear(token_dim, embed_dim)  # linear projection to d_model
        self.x_ln = nn.LayerNorm(embed_dim)  # LayerNorm for input tokens

        # linear projections for Q, K, V
        self.q_proj = nn.Linear(embed_dim, d_model)
        self.k_proj = nn.Linear(embed_dim, d_model)
        self.v_proj = nn.Linear(embed_dim, d_model)

        self.head_collect = nn.Linear(d_model, token_dim)  # linear projection to collect heads

        self.attn_drop = nn.Dropout(dropout)
        self.proj_drop = nn.Dropout(dropout)

        self.pool_attn = nn.MultiheadAttention(token_dim, 1)  # attention pooling layer
        self.queries = nn.Parameter(th.randn(self.num_tokens_h, 64, token_dim))

    ### initial size of x: [B, ]
    def forward(self, x):
        """
        x: (B, L, D)
        returns: (B, L, D)
        """
        B, L, D = x.shape ## L = 6K, D = token_dim
        h, d = self.num_heads, self.head_dim  ## d_model = h * d
        x_embed = self.x_embedding(x)  # (B, L, D) -> (B, L, embed_dim)

        x_ln = self.x_ln(x_embed)    

        # 1) project to Q,K,V and reshape for multi-head:
        #    -> (B, L, h, d) -> (B, h, L, d)
        Q = self.q_proj(x_ln).view(B, L, h, d).transpose(1, 2)
        K = self.k_proj(x_ln).view(B, L, h, d).transpose(1, 2)
        V = self.v_proj(x_ln).view(B, L, h, d).transpose(1, 2)

        # 2) scaled dot-product attention scores
        #    scores: (B, h, L, L)
        scores = (Q @ K.transpose(-2, -1)) / math.sqrt(d)
        attn = F.softmax(scores, dim=-1)
        attn = self.attn_drop(attn)

        # 3) attend to V -> (B, h, L, d)
        context = attn @ V
        # 4) merge heads -> (B, L, h, d) -> (B, L, D)
        context = context.transpose(1, 2).contiguous().view(B, L, h*d) ## (B, L, d_model)
        context = self.head_collect(context) + x # (B, L=6K, token_dim)

        ### if adopting the attention pooling
        context_pool, _ = self.pool_attn(self.queries, context.transpose(0, 1), context.transpose(0, 1))
        context_pool = context_pool.transpose(0, 1)  # [B, 2K, token_dim]
        return context_pool  # return the pooled context features

        # #### if dividing the context into three parts: H, W, P
        # y_h_mlp = context[:, :self.num_tokens_h, :] + x[:, :self.num_tokens_h, :]  # (B, 2K, token_dim)
        # y_w_mlp = context[:, self.num_tokens_h:2 * self.num_tokens_h, :] + x[:, self.num_tokens_h:2 * self.num_tokens_h, :]  # (B, 2K, token_dim)   
        # y_p_mlp = context[:, 2 * self.num_tokens_h:, :] + x[:, 2 * self.num_tokens_h:, :] # (B, 2K, token_dim)
        # return y_h_mlp, y_w_mlp, y_p_mlp ## output features of attention block

