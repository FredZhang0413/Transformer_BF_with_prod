# class TransformerBlock(nn.Module):
#     def __init__(self, token_dim, seq_len, n_head, resid_pdrop, config):

class L2OTransformer(nn.Module):
    def __init__(self, config):
        """
        Stacks T TransformerBlocks to produce an optimization trajectory.
        """
        super(L2OTransformer, self).__init__()
        self.K = config.num_users
        self.N = config.num_tx
        token_dim = config.num_tx  # embedding dimension
        seq_len = 6 * self.K  # sequence length for user-level tokens (2*K) or antenna-level tokens (2*N)
        # embedding dimension == num_tx
        self.num_tokens_h = 2 * self.K  # number of tokens in the H-stream (here 2*K)
        self.num_tokens_w = 2 * self.N  # number of tokens in the W-stream (here 2*N)

        # build n_layers identical blocks
        self.mhsa_blocks = nn.ModuleList([
            TransformerBlock(token_dim=token_dim, seq_len=seq_len, n_head=config.n_head, resid_pdrop=config.resid_pdrop, embed_dim=config.embed_dim, config=config)
        for _ in range(config.n_layers)])

        # Weight initialization.
        self.apply(self._init_weights)
        print(f"Number of parameters: {sum(p.numel() for p in self.parameters()):,}")
    
    def _init_weights(self, module):
        if isinstance(module, nn.Linear):
            nn.init.normal_(module.weight, mean=0.0, std=0.02)
            if module.bias is not None:
                nn.init.zeros_(module.bias)
        elif isinstance(module, nn.LayerNorm):
            nn.init.zeros_(module.bias)
            nn.init.ones_(module.weight)
        elif isinstance(module, nn.Embedding):
            nn.init.normal_(module.weight, mean=0.0, std=0.02)

    def forward(self, H, W_prev):
        """
        Args:
          H:      complex channel matrix (B,K,N)
          W_prev:     complex MMSE beamformer (B,K,N)
        Returns:
          H_traj: list of real/imag-concatenated channel features per step
          W_traj: list of real/imag-concatenated solutions per step
        """
        B = H.size(0)
        K = self.K  # Number of users
        N = self.N  # Number of transmit antennas
        Prod = th.bmm(H, W_prev.transpose(1, 2))  # (B, K, N) x (B, N, K) -> (B, K, K)

        H_user = th.cat([H.real, H.imag], dim=1)  # (B, 2*K, N)
        W_user = th.cat([W_prev.real, W_prev.imag], dim=1)  # (B, 2*K, N)
        P_user = th.cat([Prod.real, Prod.imag], dim=1)  # (B, 2*K, N)
        X_user = th.cat([H_user, W_user, P_user], dim=1)  # (B, 6*K, N)

        H_ant = th.cat([H.real.transpose(1, 2), H.imag.transpose(1, 2)], dim=1)  # (B, 2*N, K)
        W_ant = th.cat([W_prev.real.transpose(1, 2), W_prev.imag.transpose(1, 2)], dim=1)  # (B, 2*N, K)
        P_ant = th.cat([Prod.real.transpose(1, 2), Prod.imag.transpose(1, 2)], dim=1)  # (B, 2*N, K)
        X_ant = th.cat([H_ant, W_ant, P_ant], dim=1)  # (B, 6*N, K)

        H_traj, W_traj = [], [] ## lists to store the trajectory of solutions
        for block in self.mhsa_blocks:
            y_h_next, y_w_next, y_p_next = block(X_user, X_ant)  # (B, 2K, N) and (B, 2K, N)
            H_sol = y_h_next[:, :K, :] + 1j * y_h_next[:, K:, :]  # (B, K, N) -> complex channel features
            W_sol = y_w_next[:, :K, :] + 1j * y_w_next[:, K:, :]  # (B, K, N) -> complex beamformer
            P_sol = y_p_next[:, :K, :] + 1j * y_p_next[:, K:, :]  # (B, K, N) -> complex product features
            H_traj.append(H_sol)  
            W_traj.append(W_sol)
            H_user_update = th.cat([H_sol.real, H_sol.imag], dim=1)  # (B, 2*K, N)
            W_user_update = th.cat([W_sol.real, W_sol.imag], dim=1)  # (B, 2*K, N)
            P_user_update = th.cat([P_sol.real, P_sol.imag], dim=1)  # (B, 2*K, N)
            X_user = th.cat([H_user_update, W_user_update, P_user_update], dim=1) # (B, 4*K, N)
            H_ant_update = th.cat([H_sol.real.transpose(1, 2), H_sol.imag.transpose(1, 2)], dim=1)  # (B, 2*N, K)
            W_ant_update = th.cat([W_sol.real.transpose(1, 2), W_sol.imag.transpose(1, 2)], dim=1)  # (B, 2*N, K)
            P_ant_update = th.cat([P_sol.real.transpose(1, 2), P_sol.imag.transpose(1, 2)], dim=1)  # (B, 2*N, K)
            X_ant = th.cat([H_ant_update, W_ant_update, P_ant_update], dim=1)  # (B, 4*N, K)  
        W_pred = W_sol # (B, K, N) -> final predicted beamformer
        return H_traj, W_traj, W_pred  # return the trajectory of channel features and beamformers, and final predicted beamformer


