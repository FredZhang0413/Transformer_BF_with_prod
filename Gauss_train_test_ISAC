# Training & evaluation
# -----------------------------
class TrainConfig:
    def __init__(self):
        # Problem sizes
        self.K = 32
        self.N = 32
        self.M_total = 10

        # SNR / noise
        self.comm_sigma2 = 1.0
        self.sense_sigma2 = 0.01
        self.train_SNR_dB = 15.0
        self.SNR_lin = 10.0 ** (self.train_SNR_dB / 10.0)
        self.eta_dB = 5.0 ## sensing SNR target in dB

        # Model & optimization
        self.L = 7
        self.d_model = 512
        self.embed_dim = 128
        self.n_head = 8
        self.dropout = 0.0
        self.lr = 2e-4
        self.weight_decay = 0.0
        self.max_epoch = 600
        self.mmse_epoch = 100
        self.batch_size = 64
        self.test_batch = 128
        self.train_steps_per_epoch = 700  # like pbar_size
        self.test_steps = 200
        self.learning_rate = 2e-4

        # Sliding successive training over alternating depth
        self.milestones = [50, 100, 150, 200, 250, 300, 350, 400, 450]  # for L=10

        # PGD (optional) – here we keep blocks purely feedforward for clarity
        self.use_pgd = True
        self.pgd_steps = 5
        self.pre_pgd_steps = 10
        self.pgd_step_size = 2.25e-2
        self.pre_pgd_step_size = 2.25e-2


def train_isac(config: TrainConfig):

    ## model initialization
    model = AlternatingISAC(K=config.K, N=config.N, L=config.L,
                            d_model=config.d_model, embed_dim=config.embed_dim, n_head=config.n_head, dropout=config.dropout).to(device)

    # opt = optim.AdamW(model.parameters(), lr=config.lr, weight_decay=config.weight_decay)

    # Datasets
    train_ds = ISACDataset(config.batch_size * config.train_steps_per_epoch,
                           K=config.K, N=config.N, M_total=config.M_total, SNR_lin=config.SNR_lin)

    train_loader = DataLoader(train_ds, batch_size=config.batch_size, shuffle=True, drop_last=True)

    for epoch in range(config.max_epoch):
        # successive (freeze deeper pairs)
        suc_state = min(bisect_right(config.milestones, epoch), config.L - 1)
        for i, (cn, sn) in enumerate(zip(model.cn_blocks, model.sn_blocks)):
            if i == suc_state: ## only train the current block
                cn.train(); sn.train()
                for p in cn.parameters(): p.requires_grad = True
                for p in sn.parameters(): p.requires_grad = True
            else:
                cn.eval(); sn.eval()
                for p in cn.parameters(): p.requires_grad = False
                for p in sn.parameters(): p.requires_grad = False
            # requires = (i <= suc_state)
            # cn.train(requires); sn.train(requires)
            # for p in cn.parameters(): p.requires_grad = requires
            # for p in sn.parameters(): p.requires_grad = requires

        # opt = optim.AdamW([p for p in model.parameters() if p.requires_grad],
        #                   lr=config.lr, weight_decay=config.weight_decay)

        opt_cn = optim.AdamW([p for i, cn in enumerate(model.cn_blocks) for p in cn.parameters() if i == suc_state],
                          lr=config.lr, weight_decay=config.weight_decay)
        
        opt_sn = optim.AdamW([p for i, sn in enumerate(model.sn_blocks) for p in sn.parameters() if i == suc_state],
                          lr=config.lr, weight_decay=config.weight_decay)

        scheduler_cn = custom_lr_scheduler(opt_cn, config)
        scheduler_cn.step(epoch)

        scheduler_sn = custom_lr_scheduler(opt_sn, config)
        scheduler_sn.step(epoch)

        pbar = tqdm(train_loader, total=config.train_steps_per_epoch, desc=f"Epoch {epoch+1}")
        iters = 0
        epoch_comm = 0.0
        epoch_sense = 0.0
        epoch_sumrate = 0.0
        pbar_batches = 0

        for batch in pbar:
            if iters >= config.train_steps_per_epoch:
                break
            iters += 1

            # Assemble complex tensors
            H = to_complex(batch["H_real"], batch["H_imag"]).to(th.complex64).unsqueeze(0) ## (1,K,N)
            Hm = to_complex(batch["Hm_real"], batch["Hm_imag"]).to(th.complex64).unsqueeze(0)  # (1,M,N,N)
            G = to_complex(batch["G_real"], batch["G_imag"]).to(th.complex64).unsqueeze(0) # (1,N,N)
            mask = batch["active_mask"].to(device).unsqueeze(0)  # (1,M)

            # Expand to batch_size dimension present in DataLoader (here actually already batched)
            H = to_complex(batch["H_real"], batch["H_imag"]).to(th.complex64) # (B,K,N)
            Hm = to_complex(batch["Hm_real"], batch["Hm_imag"]).to(th.complex64) # (B,M,N,N)
            G = to_complex(batch["G_real"], batch["G_imag"]).to(th.complex64) # (B,N,N)
            mask = batch["active_mask"].to(device, dtype = th.float32) # (B,M)

            B = H.shape[0]; K = config.K; N = config.N

            # Initializers: W0 from MMSE, F0 from null-space
            W0 = compute_mmse_beamformer(H, K=K, N=N, total_power=1.0, noise_power=config.comm_sigma2) # (B,N,K)
            F0 = init_F_in_nullspace(H, N=N) # (B,N,N)

            ### if adopt PGD update for the initial beamformer
            W_prev_pre = W0.clone().requires_grad_(True)  # (B, N, K)
            for _ in range(config.pre_pgd_steps):
                loss_inner = sum_rate_with_sensing_interf(H, W_prev_pre, F0, noise_pow=config.comm_sigma2)
                grad_w = th.autograd.grad(loss_inner, W_prev_pre, create_graph=True)[0]  ## maintain second-order gradient
                W_prev_pre = proj_fro_unit(W_prev_pre + config.pre_pgd_step_size * grad_w)  # (B, N, K)
            W0 = W_prev_pre # (B, N, K)

            # # sum_rate_mmse = sum_rate(H_mat, W0, sigma2=1.0).mean().item()
            # sum_rate_mmse = sum_rate_with_sensing_interf(H, W0, F0, noise_pow=config.comm_sigma2).item()
            # mmse_rate_printed = False
            # if not mmse_rate_printed:
            #     print(f"MMSE sum rate: {sum_rate_mmse:.4f}")
            #     mmse_rate_printed = True
            #     # bp()

            vec_w0 = th.cat((th.real(W0).reshape(-1, config.N * config.K), th.imag(W0).reshape(-1, config.N * config.K)), dim=-1).reshape(-1, 2 * config.N * config.K)
            norm_W0 = th.norm(vec_w0, dim=1, keepdim=True)
            normlized_W0 = vec_w0 / norm_W0
            W_mat_0 = (normlized_W0[:, :config.N * config.K].reshape(-1, config.N, config.K) + 1j * normlized_W0[:, config.N * config.K:].reshape(-1, config.N, config.K))
            W_prev = W_mat_0.transpose(-1, -2).to(device) 

            total_rate = 0
            rate_record_per_batch = []

            total_sense_loss = 0
            sense_loss_record_per_batch = []

            H_update, G_update = H, G
            W_update, F_update = W_prev, F0

            W_traj, F_traj = [], []
            for l in range(suc_state + 1):

                ## Communication block

                F_pre_update = F_update
                y_h_next, y_w_next = model.cn_blocks[l](H_update, W_update, F_fixed=F_update)
                W_update = y_w_next[:, :config.K, :] + 1j * y_w_next[:, config.K:, :]  # (B,N,K)
                H_update = y_h_next[:, :config.K, :] + 1j * y_h_next[:, config.K:, :]  # (B,K,N)

                W_pre_pgd = W_update.clone().requires_grad_(True)
                for _ in range(config.pgd_steps):
                    sr_inner = sum_rate_with_sensing_interf(H, W_pre_pgd, F_update.detach(), noise_pow=config.comm_sigma2)
                    (grad_w_inner,) = th.autograd.grad(sr_inner, W_pre_pgd, create_graph=True)
                    W_pre_pgd = proj_fro_unit(W_pre_pgd + config.pgd_step_size * grad_w_inner)
                W_update = W_pre_pgd ## (B,N,K)
                current_rate = sum_rate_with_sensing_interf(H, W_update, F_update.detach(), noise_pow=config.comm_sigma2).item()
                total_rate += current_rate
                rate_record_per_batch.append(current_rate)

                 ## Sensing block

                y_g_next, y_f_next = model.sn_blocks[l](G_update, F_update, W_fixed=W_update)
                F_update = y_f_next[:, :config.N, :] + 1j * y_f_next[:, config.N:, :]  # (B,N,N)
                G_update = y_g_next[:, :config.N, :] + 1j * y_g_next[:, config.N:, :]  # (B,N,N)

                F_pre_pgd = F_update.clone().requires_grad_(True)
                for _ in range(config.pgd_steps):
                    s_loss_inner = sensing_barrier_loss(Hm, W_update.detach(), F_pre_pgd, mask, eta_dB=config.eta_dB,
                                                       sigma_z2=config.sense_sigma2) ## minimize it
                    (grad_f_inner,) = th.autograd.grad(-s_loss_inner, F_pre_pgd, create_graph=True)
                    F_pre_pgd = proj_fro_unit(F_pre_pgd + config.pgd_step_size * grad_f_inner)
                F_update = F_pre_pgd  ## (B,N,N)
                current_sense_loss = sensing_barrier_loss(Hm, W_update.detach(), F_update, mask, eta_dB=config.eta_dB,
                                                         sigma_z2=config.sense_sigma2).item()
                total_sense_loss += current_sense_loss
                sense_loss_record_per_batch.append(current_sense_loss)

                W_traj.append(W_update)
                F_traj.append(F_update)
            
            W_final = W_update
            F_final = F_update
            F_pre_final = F_pre_update

            final_rate = sum_rate_with_sensing_interf(H, W_final, F_pre_final.detach(), noise_pow=config.comm_sigma2)
            loss_comm = -final_rate
            opt_cn.zero_grad()
            loss_comm.backward()
            th.nn.utils.clip_grad_norm_([p for i, cn in enumerate(model.cn_blocks) for p in cn.parameters() if i == suc_state], max_norm=200.0)
            opt_cn.step()

            final_sense_loss = sensing_barrier_loss(Hm, W_final.detach(), F_final, mask, eta_dB=config.eta_dB, sigma_z2=config.sense_sigma2)
            opt_sn.zero_grad()
            final_sense_loss.backward()
            th.nn.utils.clip_grad_norm_([p for i, sn in enumerate(model.sn_blocks) for p in sn.parameters() if i == suc_state], max_norm=200.0)
            opt_sn.step()

            ave_rate = total_rate / float(suc_state + 1)
            epoch_comm += ave_rate
            ave_sense_loss = total_sense_loss / float(suc_state + 1)
            epoch_sense += ave_sense_loss
            pbar_batches += 1
            formatted_rate = [f"{r:.3f}" for r in rate_record_per_batch]
            formatted_sense_loss = [f"{s:.3f}" for s in sense_loss_record_per_batch]

            pbar.set_description(f"Epoch {epoch+1} | Rate: {formatted_rate} | Sense: {formatted_sense_loss}")

        ave_pbar_rate = epoch_comm / float(pbar_batches)
        ave_pbar_sense = epoch_sense / float(pbar_batches)
        current_lr = scheduler_cn.get_last_lr()[0]
        print(f"Epoch {epoch+1}. Avg Rate: {ave_pbar_rate:.4f}, Avg Sense Loss: {ave_pbar_sense:.4f}, LR: {current_lr:.6e}")


# test_ds = ISACDataset(config.test_batch * config.test_steps,
#                         K=config.K, N=config.N, M_total=config.M_total, SNR_lin=config.SNR_lin)

# test_loader = DataLoader(test_ds, batch_size=config.test_batch, shuffle=False)

def evaluate_isac(model: AlternatingISAC, test_loader: DataLoader, config: TrainConfig) -> float:
    model.eval()
    ave_sumrate = 0.0
    with th.no_grad():
        pbar = tqdm(test_loader, total=config.test_steps, desc="Testing")
        iters = 0
        for batch in pbar:
            if iters >= config.test_steps:
                break
            iters += 1
            H = to_complex(batch["H_real"], batch["H_imag"]).to(th.complex64)
            Hm = to_complex(batch["Hm_real"], batch["Hm_imag"]).to(th.complex64)
            G = to_complex(batch["G_real"], batch["G_imag"]).to(th.complex64)
            # mask = batch["active_mask"]  # not needed for sum-rate
            K, N = config.K, config.N

            W0 = compute_mmse_beamformer(H, K=K, N=N, total_power=1.0, noise_power=config.comm_sigma2)
            F0 = init_F_in_nullspace(H, N=N)
            W_pred, F_pred = model(H, G, W0, F0)

            sr = sum_rate_with_sensing_interf(H, W_pred, F_pred, noise_pow=config.comm_sigma2)
            ave_sumrate += sr.item()
            pbar.set_postfix(rate=f"{sr.item():.4f}")

    ave_sumrate /= float(iters)
    print(f"[Test] Average Sum-Rate: {ave_sumrate:.4f}")
    return ave_sumrate


